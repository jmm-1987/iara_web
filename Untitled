<script>
  emailjs.init("TU_PUBLIC_KEY"); // ✅ CAMBIA
  window.addEventListener('scroll', ()=>{ const m=document.getElementById('menu'); if(window.scrollY>50)m.classList.add('nav-scrolled'); else m.classList.remove('nav-scrolled');});
  document.getElementById('leadForm')?.addEventListener('submit', async (e)=>{
    e.preventDefault();
    const btn=document.getElementById('leadBtn'); const msg=document.getElementById('leadMsg');
    btn.disabled=true; btn.textContent="Enviando...";
    const templateParams={ nombre:document.getElementById('nombre').value.trim(), empresa:document.getElementById('empresa').value.trim()||"-", email:document.getElementById('email').value.trim(), proceso:document.getElementById('proceso').value.trim() };
    try{
      const SERVICE_ID="service_p8clbak";
      const TEMPLATE_ID="TU_TEMPLATE_ID"; // ✅ CAMBIA
      await emailjs.send(SERVICE_ID,TEMPLATE_ID,templateParams);
      msg.textContent="✅ Enviado. Te respondemos en breve."; msg.className="text-sm mt-2 text-green-400";
      document.getElementById('leadForm').reset();
    }catch(err){
      console.error(err);
      msg.textContent="❌ Error al enviar. Prueba WhatsApp o email."; msg.className="text-sm mt-2 text-red-400";
    }finally{ btn.disabled=false; btn.textContent="Enviar"; }
  });
</script>

